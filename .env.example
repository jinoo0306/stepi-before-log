# docker-compose가 읽는 루트 env 파일 — 실제 값은 .env로 복사해서 채운다.
# .env는 .gitignore에 의해 추적되지 않는다.

# DB 자격증명 (database 서비스 + DATABASE_URL 모두에서 사용)
POSTGRES_USER=stepi
POSTGRES_PASSWORD=stepi
POSTGRES_DB=stepi

# 프론트엔드 ↔ 백엔드 인증 키 (X-API-Key 헤더)
# 프론트(Next.js Route Handler)에서 동일한 값을 서버 사이드 환경 변수로 들고 있어야 한다.
API_KEY=jinoo0306
