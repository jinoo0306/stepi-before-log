# 프론트엔드 환경변수 템플릿 (키만 있고 값 없음).
#
# 사용:
#   cp .env.example .env.local      # 로컬 개발 — Next.js dev server가 자동 로드
#   cp .env.example .env.vercel     # Vercel 대시보드에 등록할 값을 정리해 두는 사람용 파일
#
# 두 변수 모두 서버 측 전용 — Route Handler 프록시(/api/*)가 backend로 forward할 때만 사용.
# 절대 NEXT_PUBLIC_* 접두어 붙이지 말 것 (클라이언트 번들 노출).

BACKEND_URL=
API_KEY=
