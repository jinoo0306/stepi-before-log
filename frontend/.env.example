# 프론트엔드 환경변수 템플릿 (키만, 값 없음).
#
# 사용:
#   cp .env.example .env.local      # 로컬 개발 — Next.js dev server가 자동 로드
#   cp .env.example .env.vercel     # Vercel 대시보드에 등록할 값을 정리해 두는 사람용 파일
#
# 브라우저가 backend를 직접 호출한다. NEXT_PUBLIC_ 접두어가 있어야 클라이언트 번들에 포함됨.
# API_KEY는 사내 도구 수준의 단순 헤더 키 — 노출을 받아들이는 보안 모델.

NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_API_KEY=
